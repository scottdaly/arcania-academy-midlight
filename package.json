{
  "name": "arcania-academy",
  "version": "0.1.0",
  "description": "Arcania Academy - 2D top-down pixel-art spell-crafting RPG for the browser (vanilla JS, Canvas 2D, zero runtime deps).",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:combat": "node scripts/combat-test.mjs",
    "test:dungeon": "node scripts/dungeon-test.mjs",
    "test:flow": "node scripts/world-flow.mjs",
    "test:world": "node scripts/dungeon-test.mjs && node scripts/world-flow.mjs",
    "playthrough": "node scripts/playthrough.mjs",
    "perf": "node scripts/perf.mjs",
    "test": "npm run check && npm run test:combat && npm run test:dungeon && npm run test:flow && npm run smoke && npm run playthrough",
    "shots:world": "node scripts/world-shots.mjs",
    "shots:combat": "node scripts/combat-shots.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}
